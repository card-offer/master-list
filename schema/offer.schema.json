{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-offer.github.io/master-list/schema/offer.schema.json",
  "title": "Offer",
  "type": "object",
  "required": [
    "benefit",
    "category",
    "country",
    "dates_source_url",
    "eligibility",
    "eligible_card_ids",
    "end_date",
    "id",
    "last_checked",
    "source_url",
    "source_verified",
    "sources",
    "start_date",
    "terms_url",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9-]+$"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "issuer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "network": {
      "oneOf": [
        {
          "enum": [
            "visa",
            "mastercard",
            "amex",
            "unionpay",
            "jcb",
            "diners"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "merchant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "benefit": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "value_pct": {
          "type": "number"
        },
        "value_text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "min_spend_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "eligibility": {
      "type": "object",
      "required": [
        "scope",
        "rule"
      ],
      "properties": {
        "scope": {
          "enum": [
            "card",
            "issuer",
            "issuer_network",
            "network"
          ]
        },
        "rule": {
          "type": "string"
        },
        "issuer_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "networks": {
          "type": "array",
          "items": {
            "enum": [
              "visa",
              "mastercard",
              "amex",
              "unionpay",
              "jcb",
              "diners"
            ]
          }
        },
        "card_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "card_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "stated",
            "inferred",
            "assumed"
          ]
        }
      }
    },
    "eligible_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cross_border": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "merchant_country": {
          "type": [
            "string",
            "null"
          ]
        },
        "card_issuing_countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2"
          }
        }
      }
    },
    "terms_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "The deal's own T&C link (PDF or page). Never the bank's general T&C."
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_verified": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "kind",
          "fetched_at"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "enum": [
              "issuer_product_page",
              "issuer_listing",
              "issuer_promotion_page",
              "issuer_promotion_listing",
              "network_offer_page",
              "merchant_page",
              "issuer_terms_document"
            ]
          },
          "fetched_at": {
            "type": "string"
          }
        }
      }
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    },
    "detail_level": {
      "enum": [
        "structured",
        "title_only"
      ],
      "description": "title_only: official promotion page found, but no benefit value, validity, merchant or minimum spend could be parsed. Read source_url."
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "First day of the deal as written in the deal's own T&C or page. Null when not stated (never guessed)."
    },
    "start_date_null_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_stated_in_terms_or_page",
        null
      ],
      "description": "Required when start_date is null."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Last day of the deal as written in the deal's own T&C or page. Required: offers without one are held back from publishing."
    },
    "dates_text": {
      "type": "string",
      "description": "Verbatim sentence the dates were read from."
    },
    "dates_source_url": {
      "type": "string",
      "format": "uri",
      "description": "Document the dates were read from (T&C or deal page)."
    },
    "dates_last_checked": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "min_spend_source_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "cap_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Cap or redemption limit sentence, verbatim."
    },
    "cap_source_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "terms_url_null_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why terms_url is null, for example no_deal_specific_terms_link_on_page."
    },
    "terms_scope": {
      "enum": [
        "deal_document",
        "deal_page_section",
        null
      ],
      "description": "deal_document: a T&C document for this deal. deal_page_section: the T&C section printed on the deal page."
    },
    "terms_clauses": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "n",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "The deal's own T&C text as ordered clauses, verbatim."
    },
    "terms_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the T&C text, lower-cased with whitespace collapsed."
    },
    "terms_fetched_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "start_date": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "start_date_null_reason"
        ],
        "properties": {
          "start_date_null_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terms_url": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "terms_url_null_reason"
        ],
        "properties": {
          "terms_url_null_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terms_clauses": {
            "type": "array"
          }
        },
        "required": [
          "terms_clauses"
        ]
      },
      "then": {
        "required": [
          "terms_hash",
          "terms_fetched_at",
          "terms_scope"
        ]
      }
    }
  ]
}
