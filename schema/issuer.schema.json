{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-offer.github.io/master-list/schema/issuer.schema.json",
  "title": "Issuer",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "country", "website", "official_domains", "card_ids", "crawl"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z]{2}-[a-z0-9-]+$"},
    "name": {"type": "string"},
    "legal_name": {"type": ["string", "null"]},
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "website": {"type": "string", "format": "uri"},
    "official_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "card_ids": {"type": "array", "items": {"type": "string"}},
    "offer_count": {"type": "integer"},
    "crawl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_sources", "offer_sources", "status"],
      "properties": {
        "card_sources": {"type": "array", "items": {"type": "string"}},
        "offer_sources": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["ok", "partial", "blocked", "not_covered"]},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
