{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-offer.github.io/master-list/schema/merchant.schema.json",
  "title": "Merchant",
  "type": "object",
  "required": [
    "id",
    "name",
    "country",
    "categories",
    "offer_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "offer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}